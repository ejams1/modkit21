# Fallout 4 Modding Project — Environment Configuration
# Copy this file to .env and update paths for your system.
# All values MUST be quoted (paths may contain spaces).
# Forward slashes work in git bash on Windows.

# Project root — auto-detected from this file's location (do not change)
MOD_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Fallout 4 install directory — UPDATE THIS to your FO4 location
FO4_DIR="C:/Program Files (x86)/Steam/steamapps/common/Fallout 4"
FO4_DATA="$FO4_DIR/Data"
FO4_COMPILER="$FO4_DIR/Papyrus Compiler/PapyrusCompiler.exe"
FO4_FLAGS="Institute_Papyrus_Flags.flg"

# Project paths — relative to MOD_ROOT (no changes needed)
FO4_SCRIPTS_USER="$MOD_ROOT/Scripts/Source/User"
FO4_SCRIPTS_BASE="$MOD_ROOT/Scripts/Source/Base"
FO4_SCRIPTS_OUTPUT="$MOD_ROOT/Scripts"
MOD_SOURCE="$MOD_ROOT/Scripts/Source"
MOD_PREFIX="B21"

# Spriggit CLI
SPRIGGIT_CLI="$MOD_ROOT/resource/spriggit/Spriggit.CLI.exe"

# Extracted game directories — for behavior indexing (preprocess_behaviors.py)
# FO4_EXTRACTED_DIR: Path to extracted Fallout 4 BSAs (must contain Data/Meshes/)
FO4_EXTRACTED_DIR=""
# FO76_EXTRACTED_DIR: Optional — path to extracted Fallout 76 BSAs for reference
FO76_EXTRACTED_DIR=""
# FO3_EXTRACTED_DIR: Optional — path to extracted Fallout 3 BSAs for reference
FO3_EXTRACTED_DIR=""

# Skyrim Special Edition
SKYRIM_DIR="C:/Program Files (x86)/Steam/steamapps/common/Skyrim Special Edition"
SKYRIM_SCRIPTS_USER="$MOD_ROOT/Scripts/Source/User"
SKYRIM_SCRIPTS_BASE=""
SKYRIM_EXTRACTED_DIR=""

# Starfield
STARFIELD_DIR="C:/Program Files (x86)/Steam/steamapps/common/Starfield"
STARFIELD_DATA_DIR="$STARFIELD_DIR/Data"
STARFIELD_SCRIPTS_USER="$MOD_ROOT/Scripts/Source/User"
STARFIELD_SCRIPTS_BASE=""
STARFIELD_EXTRACTED_DIR=""
